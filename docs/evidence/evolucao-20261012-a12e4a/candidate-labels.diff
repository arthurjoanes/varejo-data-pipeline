+          },
+          "required": ["message", "programmingLanguage"]
+        }
+      ],
+      "type": "object"
+    }
+  },
+  "type": "object",
+  "properties": {
+    "errorMessage": {
+      "$ref": "#/$defs/ErrorMessageRunFacet"
